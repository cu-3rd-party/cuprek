# --- Telegram ---
# Bot token from @BotFather. IMPORTANT: run /setprivacy -> Disable for this bot,
# otherwise it will not see regular group messages.
BOT_TOKEN=123456:AA...

# Comma-separated Telegram user IDs allowed to moderate submissions, run /status,
# and seed circles by sending video notes to the bot in DM.
ADMIN_IDS=11111111,22222222

# Chat ID of the private moderator group where submissions are posted for review.
# Add the bot to that group, then send /id there to learn the value (starts with -100).
MOD_CHAT_ID=-1001234567890

# Optional: restrict profanity watching to these chat IDs (comma-separated).
# Leave empty to watch every group the bot is added to.
ALLOWED_CHAT_IDS=

# --- Database ---
# docker-compose builds DATABASE_URL from these and points the bot at the "postgres"
# service. Keep the password alphanumeric: it is interpolated into a URL, so @ : / #
# would need escaping.
POSTGRES_USER=bot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=circlebot

# Only used when running the bot outside docker-compose (compose overrides it).
DATABASE_URL=postgresql+asyncpg://bot:changeme@localhost:5432/circlebot

# --- Behaviour ---
TIMEZONE=Europe/Moscow
MAX_PENDING_PER_USER=5
ADMIN_DM_AUTO_ACCEPT=true

# Profanity -> circle probability curve.
# No circle while daily profane messages <= PROFANITY_FREE_MESSAGES.
# Chance (percent) = BASE + (count - (FREE + 1)) * STEP, capped at 100.
PROFANITY_FREE_MESSAGES=3
PROFANITY_BASE_CHANCE=1.0
PROFANITY_STEP=0.5

# --- Runtime ---
DROP_PENDING_UPDATES=true
LOG_LEVEL=INFO

# --- Remote observability ---
# Mirror WARNING+ log lines into a Telegram chat so you hear about breakage without
# SSH-ing in. Sends are rate-limited and de-duplicated; full detail stays in the logs.
ALERT_ENABLED=true
ALERT_LEVEL=WARNING
# Leave empty to use MOD_CHAT_ID.
ALERT_CHAT_ID=

# Liveness: the bot pings Postgres and touches this file on a timer; the container
# healthcheck fails once it goes stale (see `docker compose ps`).
HEARTBEAT_FILE=/tmp/circlebot.heartbeat
HEARTBEAT_INTERVAL=30
HEARTBEAT_MAX_AGE=120
